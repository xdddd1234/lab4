
@startuml
title UC-03 - Видача книги (Activity Diagram)

|Бібліотекар|
start
:Вибрати читача та книгу;
:Вказати дату повернення;
:> Надіслати запит на видачу;

|Бібліотечна система|
:< Отримати запит на видачу;
:Знайти читача за reader_id;

if (Читача знайдено?) then (Так)

  :Знайти книгу за book_id;

  if (Книгу знайдено?) then (Так)

    :Перевірити активну видачу;

    if (Книга доступна?) then (Так)

      :Отримати поточну дату;
      :Перевірити due_date;

      if (due_date >= loan_date?) then (Так)

        :Створити Loan;
        :Зберегти loan_date та due_date;
        :Встановити return_date = null;

        fork
          :Підготувати повідомлення
          про успішну видачу;
        fork again
          :Підготувати дані
          підтвердження видачі;
        end fork

        :> Надіслати сигнал LoanIssued;

        |Бібліотекар|
        :< Отримати сигнал LoanIssued;
        :Переглянути підтвердження;
        stop

      else (Ні)
        :Підготувати помилку
        "Неправильна дата повернення";
      endif

    else (Ні)
      :Підготувати помилку
      "Книга вже видана";
    endif

  else (Ні)
    :Підготувати помилку
    "Книгу не знайдено";
  endif

else (Ні)
  :Підготувати помилку
  "Читача не знайдено";
endif

:> Надіслати сигнал LoanRejected;

|Бібліотекар|
:< Отримати сигнал LoanRejected;
:Переглянути причину відмови;
stop

@enduml
