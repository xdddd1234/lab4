
@startuml
title UC-03 - Видача книги (Activity Diagram)

|Бібліотекар|
start
:Вибрати читача та книгу;
:Вказати due_date;
:Надіслати запит submitLoan();

|Бібліотечна система|
:findReaderById(readerId);

if (Читача знайдено?) then (Так)

  :findBookById(bookId);

  if (Книгу знайдено?) then (Так)

    :findActiveLoan(bookId);

    if (Активної видачі немає?) then (Так)

      :today();
      :validateDueDate(dueDate, loanDate);

      if (due_date >= loan_date?) then (Так)

        :createLoan(readerId, bookId,
        loanDate, dueDate);
        :return_date = null;

        fork
          :Підготувати повідомлення
          про успішну видачу;
        fork again
          :Підготувати дані Loan
          для підтвердження;
        end fork

        :Надіслати LoanIssued
        бібліотекарю; <<sendSignal>>

        |Бібліотекар|
        :Отримати LoanIssued; <<acceptEvent>>
        :Переглянути результат;

        if (Підтвердження отримання надіслано?) then (Так)
          :Надіслати Ack;
        else (Ні)
          :Не надсилати Ack;
        endif

        |Бібліотечна система|
        if (Ack отримано до тайм-ауту?) then (Так)
          :Зафіксувати підтвердження;
        else (Ні)
          :Завершити без повторної видачі;
        endif

        stop

      else (Ні)
        :Помилка дати повернення;
      endif

    else (Ні)
      :Книга вже видана;
    endif

  else (Ні)
    :Книгу не знайдено;
  endif

else (Ні)
  :Читача не знайдено;
endif

:Надіслати LoanRejected
бібліотекарю; <<sendSignal>>

|Бібліотекар|
:Отримати LoanRejected; <<acceptEvent>>
:Переглянути причину відмови;

stop
@enduml
