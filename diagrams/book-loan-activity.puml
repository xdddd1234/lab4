
@startuml
title UC-03 - Видача книги

|Бібліотекар|
start
:Вибрати читача і книгу;
:Вказати дату повернення;
:Надіслати запит на видачу;

|Бібліотечна система|
:Знайти читача за reader_id;

if (Читача знайдено?) then (Так)
  :Знайти книгу за book_id;

  if (Книгу знайдено?) then (Так)
    :Перевірити активну видачу;

    if (Книга доступна?) then (Так)
      :Отримати поточну дату;
      :Перевірити due_date;

      if (due_date >= loan_date?) then (Так)
        :Створити запис Loan;
        :Зберегти loan_date і due_date;
        :Встановити return_date = null;

        fork
          :Підготувати повідомлення
          про успішну видачу;
        fork again
          :Підготувати дані
          підтвердження;
        end fork

        :Надіслати сигнал LoanIssued;
        |Бібліотекар|
        :Отримати LoanIssued;
        :Переглянути результат;
        stop

      else (Ні)
        :Помилка дати повернення;
      endif

    else (Ні)
      :Книга вже видана;
    endif

  else (Ні)
    :Книгу не знайдено;
  endif

else (Ні)
  :Читача не знайдено;
endif

:Надіслати сигнал LoanRejected;

|Бібліотекар|
:Отримати LoanRejected;
:Переглянути причину відмови;
stop

@enduml
